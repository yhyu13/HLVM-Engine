+	TArray<TBYTE> FileContent;
+	if (!::LoadFileToArray(FileContent, *InFilePath))
 	{
-		HLVM_LOG(LogRHI, err, TXT("Failed to load shader file: {0}"), *FString(FilePath));
+		HLVM_LOG(LogRHI, err, TXT("Failed to load shader file: {0}"), *FString(InFilePath));
 		return false;
 	}
 
-	// Create shader module from bytecode
-	nvrhi::ShaderModuleDesc Desc;
+	// Create shader from bytecode
+	nvrhi::ShaderDesc Desc;
 	Desc.setShaderType(ShaderType);
-	Desc.setBytecode(FileContent.GetData(), FileContent.Num() * sizeof(TCHAR));
-	Desc.setEntryPoint(EntryPointName);
-
-	ShaderModuleHandle = Device->createShaderModule(Desc);
