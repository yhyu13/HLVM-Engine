-
-#include "Renderer/RHI/Object/PipelineState.h"
-
-bool FGraphicsPipelineState::CreatePipeline(
-	nvrhi::IDevice*				   Device,
-	nvrhi::IRenderPass*			   RenderPass,
-	const FShaderModule&		   VertexShader,
-	const FShaderModule&		   FragmentShader,
-	const nvrhi::VertexAttributeDesc* VertexAttributes,
-	TUINT32						   NumVertexAttributes,
-	TUINT32						   VertexStride)
-{
-	HLVM_ENSURE_F(!PipelineHandle, TXT("Pipeline already created"));
-	HLVM_ENSURE_F(Device, TXT("Device is null"));
-	HLVM_ENSURE_F(RenderPass, TXT("Render pass is null"));
-	HLVM_ENSURE_F(VertexShader.GetShaderModuleHandle(), TXT("Vertex shader not initialized"));
-	HLVM_ENSURE_F(FragmentShader.GetShaderModuleHandle(), TXT("Fragment shader not initialized"));
-
-	this->Device = Device;
-
-	// Create pipeline layout (empty for now - can be extended with descriptor sets)
-	nvrhi::PipelineLayoutDesc LayoutDesc;
-	PipelineLayoutHandle = Device->createPipelineLayout(LayoutDesc);
-	HLVM_ENSURE_F(PipelineLayoutHandle, TXT("Failed to create pipeline layout"));
-
-	// Build shader stage descriptions
-	TArray<nvrhi::ShaderModuleHandle> ShaderModules;
-	ShaderModules.Add(VertexShader.GetShaderModuleHandle());
-	ShaderModules.Add(FragmentShader.GetShaderModuleHandle());
-
-	TArray<nvrhi::ShaderDesc> ShaderDescs;
-	
-	nvrhi::ShaderDesc VSDesc;
-	VSDesc.setShaderStage(nvrhi::ShaderStage::Vertex);
-	VSDesc.setShaderModule(VertexShader.GetShaderModuleHandle().Get());
-	VSDesc.setEntryPoint(VertexShader.GetEntryPointName());
-	ShaderDescs.Add(VSDesc);
-
-	nvrhi::ShaderDesc PSDesc;
-	PSDesc.setShaderStage(nvrhi::ShaderStage::Pixel);
-	PSDesc.setShaderModule(FragmentShader.GetShaderModuleHandle().Get());
-	PSDesc.setEntryPoint(FragmentShader.GetEntryPointName());
-	ShaderDescs.Add(PSDesc);
-
-	// Create vertex layout
-	nvrhi::VertexLayoutDesc VertexLayout;
-	VertexLayout.addInputBinding(0, VertexStride);
-	
-	for (TUINT32 i = 0; i < NumVertexAttributes; i++)
-	{
-		VertexLayout.addInputAttribute(VertexAttributes[i]);
-	}
-
-	// Graphics pipeline description
-	nvrhi::GraphicsPipelineDesc PipelineDesc;
-	PipelineDesc.setPipelineLayout(PipelineLayoutHandle.Get());
-	PipelineDesc.setRenderPass(RenderPass);
-	PipelineDesc.setSubpassIndex(0);
-	
-	// Set shaders
-	PipelineDesc.setVS(ShaderDescs[0]);
-	PipelineDesc.setPS(ShaderDescs[1]);
-
-	// Vertex input layout
-	PipelineDesc.setInputLayout(VertexLayout);
-
-	// Rasterizer state
