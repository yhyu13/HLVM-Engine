@@ -1,125 +0,0 @@
-/**
- * Copyright (c) 2026. MIT License. All rights reserved.
- *
- *  Pipeline State Objects
- *
- *  Graphics pipeline state management using NVRHI.
- */
-
-#pragma once
-
-#include "Renderer/RHI/Common.h"
-#include "Renderer/RHI/Object/ShaderModule.h"
-
-/*-----------------------------------------------------------------------------
-    FGraphicsPipelineState - Graphics Pipeline State Object
------------------------------------------------------------------------------*/
-
-/**
- * Graphics pipeline state object (PSO)
- *
- * Manages:
- * - Shader stages (vertex, fragment, geometry, etc.)
- * - Vertex input layout
- * - Rasterization state
- * - Color blending state
- * - Depth/stencil state
- *
- * Usage:
- * 1. Create instance
- * 2. Configure pipeline description
- * 3. Call CreatePipeline()
- * 4. Bind with CommandList->bindPipeline()
- */
-class FGraphicsPipelineState
-{
-public:
-	NOCOPYMOVE(FGraphicsPipelineState)
-
-	FGraphicsPipelineState();
-	virtual ~FGraphicsPipelineState();
-
-	// Pipeline creation
-	bool CreatePipeline(
-		nvrhi::IDevice*				  Device,
-		nvrhi::IRenderPass*			  RenderPass,
-		const FShaderModule&		  VertexShader,
-		const FShaderModule&		  FragmentShader,
-		const nvrhi::VertexAttributeDesc* VertexAttributes,
-		TUINT32						  NumVertexAttributes,
-		TUINT32						  VertexStride);
-
-	// Access
-	[[nodiscard]] nvrhi::PipelineHandle GetPipelineHandle() const { return PipelineHandle; }
-	[[nodiscard]] nvrhi::PipelineLayoutHandle GetPipelineLayoutHandle() const { return PipelineLayoutHandle; }
-
-	// Debug name
-	void SetDebugName(const TCHAR* Name);
-
-protected:
-	nvrhi::PipelineHandle		PipelineHandle;
-	nvrhi::PipelineLayoutHandle PipelineLayoutHandle;
-	nvrhi::IDevice*				Device;
-	TCharArray<64>				DebugName;
-};
-
-/*-----------------------------------------------------------------------------
-    FComputePipelineState - Compute Pipeline State Object
------------------------------------------------------------------------------*/
-
-/**
- * Compute pipeline state object
- *
- * Usage:
- * 1. Create instance
- * 2. Call CreatePipeline() with compute shader
- * 3. Bind with CommandList->bindPipeline()
- */
-class FComputePipelineState
-{
-public:
-	NOCOPYMOVE(FComputePipelineState)
-
-	FComputePipelineState();
-	virtual ~FComputePipelineState();
-
-	// Pipeline creation
-	bool CreatePipeline(
-		nvrhi::IDevice*		 Device,
-		const FShaderModule& ComputeShader);
-
-	// Access
-	[[nodiscard]] nvrhi::PipelineHandle GetPipelineHandle() const { return PipelineHandle; }
-	[[nodiscard]] nvrhi::PipelineLayoutHandle GetPipelineLayoutHandle() const { return PipelineLayoutHandle; }
-
-protected:
-	nvrhi::PipelineHandle		PipelineHandle;
-	nvrhi::PipelineLayoutHandle PipelineLayoutHandle;
-	nvrhi::IDevice*				Device;
-};
-
-/*-----------------------------------------------------------------------------
-    Inline Implementations
------------------------------------------------------------------------------*/
-
-HLVM_INLINE_FUNC FGraphicsPipelineState::FGraphicsPipelineState()
-	: Device(nullptr)
-{
-}
-
-HLVM_INLINE_FUNC FGraphicsPipelineState::~FGraphicsPipelineState()
-{
-	PipelineHandle.Reset();
-	PipelineLayoutHandle.Reset();
-}
-
-HLVM_INLINE_FUNC FComputePipelineState::FComputePipelineState()
-	: Device(nullptr)
-{
