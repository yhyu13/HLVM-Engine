+		bool ret;
+		for (TUINT8 i = HLVM_ENUM_VALUE(EPlatformFileType::Unspecified) + 1; i < EPlatformFileType_NUM; i++)
+		{
+			ret = sPlatformFileRedirector[i]->IsDirectory(path);
+			if (ret)
+			{
+				return true;
